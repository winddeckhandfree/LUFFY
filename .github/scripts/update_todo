#!/usr/bin/env python3
import json, os, pathlib, re, subprocess
os.chdir(os.environ.get("GITHUB_WORKSPACE", "."))
TITLE = "### \U0001F4DD Complete TODO List"
readme_path = pathlib.Path("README.md")
text = readme_path.read_text(encoding="utf-8")
lines = text.splitlines(keepends=True)
title_i = next(i for i, line in enumerate(lines) if line.strip() == TITLE)
next_h2 = next((i for i in range(title_i + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
head = "".join(lines[:title_i + 1])
tail = "".join(lines[next_h2:])
body = "".join(lines[title_i + 1:next_h2])
entry_re = re.compile(r"^- \[ \] \*\*(?P<path>.+?):(?P<line>\d+)\*\* - (?P<text>.*)$")
base = []
for line in body.splitlines():
    m = entry_re.match(line)
    if m:
        d = m.groupdict(); d["line"] = int(d["line"]); d["raw"] = line
        base.append(d)

def todo_text(line):
    s = line[line.find("TODO") + 4:]
    return re.sub(r"^\s*:?\s*", "", s).strip()

def extract(path):
    out = []
    with open(path, encoding="utf-8") as f:
        for n, line in enumerate(f, 1):
            if "TODO" in line:
                out.append({"path": path.as_posix(), "line": n, "text": todo_text(line)})
    return out

subprocess.run(["git", "fetch", "origin", "main"], check=False, capture_output=True, text=True)
changed = sorted(x for x in subprocess.check_output(["git", "diff", "--name-only", "origin/main...HEAD"], text=True).splitlines() if x.endswith(".py"))
changed_set = set(changed)
print("BASELINE", len(base), "CHANGED", json.dumps(changed))
fresh = {}
for p in changed:
    pp = pathlib.Path(p)
    if pp.exists():
        recs = extract(pp)
        fresh[p] = recs
        for r in recs:
            print(f"{p}:{r['line']}: {r['text']}")
kept = [d for d in base if d["path"] not in changed_set]
final = list(kept)
for recs in fresh.values():
    final.extend(recs)
final.sort(key=lambda d: (d["path"], d["line"]))
raw_lookup = {(d["path"], d["line"], d["text"]): d["raw"] for d in base}
out = []
for d in final:
    key = (d["path"], d["line"], d["text"])
    out.append(raw_lookup.get(key, f"- [ ] **{d['path']}:{d['line']}** - {d['text']}"))
new_text = head + "\n" + "\n".join(out) + "\n\n" + tail
print("FINAL", len(out))
if os.environ.get("APPLY") == "true":
    if new_text != text:
        readme_path.write_text(new_text, encoding="utf-8")
        subprocess.run(["git", "config", "user.name", "github-actions[bot]"], check=True)
        subprocess.run(["git", "config", "user.email", "41898282+github-actions[bot]@users.noreply.github.com"], check=True)
        subprocess.run(["git", "add", "README.md"], check=True)
        subprocess.run(["git", "commit", "-m", "docs: update complete TODO list"], check=True)
        subprocess.run(["git", "push", "origin", "HEAD:dev"], check=True)
        print("PUSHED")
    else:
        print("NOCHANGE")
else:
    print(new_text[len(head):][:3000])
